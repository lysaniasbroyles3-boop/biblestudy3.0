:root {
    --bg: #f5f7fb;
    --card: #ffffff;
    --text: #172033;
    --text-secondary: #718096;
    --muted: #718096;
    --primary: #6B5AE8;
    --primary-dark: #4545b8;
    --primary-light: rgba(107, 90, 232, 0.1);
    --border: #e7eaf2;
    --gold: #f2b84b;
    --success: #2da86e;
    --shadow: 0 10px 30px rgba(27, 35, 70, 0.1);
    --shadow-lg: 0 20px 50px rgba(27, 35, 70, 0.15);
}

body.dark {
    --bg: #0e1220;
    --card: #171c2d;
    --text: #f5f7ff;
    --text-secondary: #a0aac0;
    --muted: #9ca6bf;
    --border: #292f45;
    --shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 20px 50px rgba(0, 0, 0, 0.4);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    transition: background 0.3s ease, color 0.3s ease;
    line-height: 1.6;
}

button {
    border: none;
    cursor: pointer;
    font-family: inherit;
}

/* HEADER */

.topbar {
    height: 76px;
    background: var(--card);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    padding: 0 5%;
    gap: 35px;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow);
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-right: auto;
}

.brand-icon {
    width: 42px;
    height: 42px;
    border-radius: 13px;
    background: linear-gradient(135deg, var(--primary), #8c65e8);
    color: white;
    display: grid;
    place-items: center;
    font-size: 21px;
    box-shadow: 0 8px 20px rgba(107, 90, 232, 0.35);
}

.brand h1 {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.5px;
}

.brand span {
    font-size: 11px;
    color: var(--muted);
}

nav {
    display: flex;
    gap: 7px;
}

.nav-btn,
.theme-button {
    border: none;
    background: transparent;
    color: var(--muted);
    padding: 10px 13px;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 600;
    font-size: 14px;
    transition: all 0.2s ease;
}

.nav-btn:hover {
    background: var(--primary-light);
    color: var(--primary);
}

.nav-btn.active {
    background: var(--primary-light);
    color: var(--primary);
    font-weight: 700;
}

.theme-button {
    font-size: 18px;
    padding: 8px 12px;
}

.theme-button:hover {
    background: var(--primary-light);
}

/* MAIN */

main {
    max-width: 1250px;
    margin: auto;
    padding: 45px 25px;
}

.section {
    display: none;
    animation: fadeIn 0.3s ease;
}

.active-section {
    display: block;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* HERO */

.hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 35px;
    gap: 50px;
}

.eyebrow {
    color: var(--primary);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
    margin-bottom: 9px;
    text-transform: uppercase;
}

.hero h2 {
    font-size: clamp(35px, 5vw, 58px);
    line-height: 1.02;
    letter-spacing: -2px;
    font-weight: 800;
}

.hero h2 span {
    color: var(--primary);
}

.hero-text {
    color: var(--muted);
    max-width: 580px;
    margin-top: 16px;
    line-height: 1.6;
    font-size: 16px;
}

.level-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 15px;
    box-shadow: var(--shadow);
    min-width: 200px;
    flex-shrink: 0;
}

.level-circle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), #8b67e9);
    color: white;
    display: grid;
    place-items: center;
    font-size: 23px;
    font-weight: 800;
    box-shadow: 0 8px 20px rgba(107, 90, 232, 0.3);
}

.level-card p {
    color: var(--muted);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.level-card strong {
    display: block;
    margin-top: 4px;
    font-size: 14px;
}

/* STATS */

.dashboard-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 25px;
}

.stat-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 17px;
    padding: 18px;
    display: flex;
    align-items: center;
    gap: 13px;
    box-shadow: var(--shadow);
    transition: all 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.stat-card > span {
    font-size: 25px;
}

.stat-card small {
    display: block;
    color: var(--muted);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.stat-card strong {
    display: block;
    margin-top: 4px;
    font-weight: 700;
}

/* CONTENT */

.content-grid {
    display: grid;
    grid-template-columns: 1.6fr 0.8fr;
    gap: 20px;
    margin-bottom: 20px;
}

.verse-card,
.side-card,
.reflection-card,
.big-level-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 28px;
    box-shadow: var(--shadow);
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.card-header h3 {
    font-size: 23px;
    font-weight: 700;
}

.icon-button {
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--muted);
    width: 42px;
    height: 42px;
    border-radius: 12px;
    font-size: 22px;
    cursor: pointer;
    transition: all 0.2s ease;
    flex-shrink: 0;
}

.icon-button:hover {
    transform: scale(1.08);
}

.icon-button.favorite {
    color: #ef6685;
    background: rgba(239, 102, 133, 0.1);
    border-color: rgba(239, 102, 133, 0.2);
}

.verse-content {
    position: relative;
    padding: 40px 25px;
    margin-top: 20px;
    background: linear-gradient(180deg, rgba(107, 90, 232, 0.05), transparent);
    border-radius: 16px;
}

.quote-mark {
    position: absolute;
    font-size: 80px;
    color: var(--primary);
    opacity: 0.15;
    top: 10px;
    left: -5px;
    line-height: 1;
}

.verse-content p {
    font-family: 'Georgia', serif;
    font-size: clamp(20px, 3vw, 28px);
    line-height: 1.65;
    position: relative;
    letter-spacing: -0.3px;
}

.verse-footer {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 12px;
    padding-bottom: 20px;
    padding-top: 20px;
}

.verse-footer span:first-child {
    background: var(--primary-light);
    color: var(--primary);
    padding: 5px 9px;
    border-radius: 7px;
    font-weight: 800;
}

.primary-button,
.secondary-button {
    border: none;
    border-radius: 12px;
    padding: 14px 20px;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
}

.primary-button {
    width: 100%;
    color: white;
    background: linear-gradient(135deg, var(--primary), #8063df);
    box-shadow: 0 10px 25px rgba(107, 90, 232, 0.25);
    margin-top: 15px;
}

.primary-button:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 15px 35px rgba(107, 90, 232, 0.35);
}

.primary-button:active:not(:disabled) {
    transform: translateY(0);
}

.primary-button.completed {
    background: linear-gradient(135deg, var(--success), #1f8a56);
    box-shadow: 0 10px 25px rgba(45, 168, 110, 0.25);
    cursor: not-allowed;
    opacity: 0.9;
}

.primary-button:disabled {
    cursor: not-allowed;
    opacity: 0.7;
}

/* XP */

.xp-badge {
    background: rgba(242, 184, 75, 0.15);
    color: #bd841e;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 800;
}

.progress-info {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 12px;
    margin: 28px 0 8px;
    font-weight: 700;
}

.progress-bar {
    height: 10px;
    background: var(--border);
    border-radius: 100px;
    overflow: hidden;
}

.progress-bar div {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--primary), #9b72ec);
    border-radius: inherit;
    transition: width 0.7s ease;
}

.progress-bar.large {
    margin: 15px 0 8px;
}

.small-text {
    color: var(--muted);
    font-size: 12px;
    margin-top: 12px;
}

.mini-mission {
    display: flex;
    gap: 12px;
    padding: 15px;
    background: var(--primary-light);
    border-radius: 13px;
    margin-top: 25px;
    border: 1px solid rgba(107, 90, 232, 0.2);
}

.mini-mission > span {
    font-size: 25px;
}

.mini-mission strong {
    display: block;
}

.mini-mission p {
    color: var(--muted);
    font-size: 12px;
    margin-top: 4px;
}

/* REFLECTION */

.reflection-card {
    margin-top: 20px;
}

.reflection-heading {
    display: flex;
    justify-content: space-between;
    margin-bottom: 16px;
}

.reflection-heading > span {
    font-size: 30px;
}

.reflection-card h3 {
    margin-bottom: 18px;
}

textarea {
    width: 100%;
    min-height: 130px;
    resize: vertical;
    border: 1px solid var(--border);
    background: rgba(107, 90, 232, 0.02);
    color: var(--text);
    border-radius: 14px;
    padding: 15px;
    font: inherit;
    outline: none;
    transition: all 0.2s ease;
}

textarea:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(107, 90, 232, 0.1);
}

.secondary-button {
    margin-top: 12px;
    background: var(--primary-light);
    color: var(--primary);
    border: 1px solid rgba(107, 90, 232, 0.2);
}

.secondary-button:hover {
    background: rgba(107, 90, 232, 0.15);
    transform: translateY(-1px);
}

#savedMessage {
    color: var(--success);
    margin-left: 12px;
    font-size: 12px;
    font-weight: 700;
}

/* MODAL */

.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    animation: fadeIn 0.2s ease;
}

.modal.show {
    display: flex;
}

.modal-content {
    background: var(--card);
    border-radius: 24px;
    box-shadow: var(--shadow-lg);
    max-width: 400px;
    width: 90%;
    animation: slideUp 0.3s ease;
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px;
    border-bottom: 1px solid var(--border);
}

.modal-header h2 {
    font-size: 22px;
    margin: 0;
}

.modal-close {
    background: transparent;
    border: none;
    font-size: 28px;
    color: var(--muted);
    cursor: pointer;
    padding: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    transition: all 0.2s ease;
}

.modal-close:hover {
    background: var(--primary-light);
    color: var(--primary);
}

.modal-body {
    padding: 24px;
    text-align: center;
}

.modal-icon {
    font-size: 60px;
    margin-bottom: 16px;
    display: block;
}

.modal-body p {
    color: var(--muted);
    margin-bottom: 16px;
}

.modal-stats {
    background: var(--primary-light);
    border-radius: 12px;
    padding: 16px;
    margin-top: 16px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.stat-item {
    text-align: center;
}

.stat-item strong {
    display: block;
    font-size: 18px;
    color: var(--primary);
}

.stat-item small {
    display: block;
    font-size: 11px;
    color: var(--muted);
    margin-top: 4px;
    text-transform: uppercase;
}

/* OTHER PAGES */

.page-heading {
    margin-bottom: 30px;
}

.page-heading h2 {
    font-size: 40px;
    margin-bottom: 8px;
    font-weight: 800;
    letter-spacing: -1px;
}

.page-heading > p:last-child {
    color: var(--muted);
}

.big-level-card {
    display: flex;
    align-items: center;
    gap: 30px;
}

.big-level-number {
    width: 115px;
    height: 115px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: white;
    font-size: 40px;
    font-weight: 900;
    background: linear-gradient(135deg, var(--primary), #8c65e8);
    box-shadow: var(--shadow-lg);
    flex-shrink: 0;
}

.big-level-info {
    flex: 1;
}

.big-level-info > p {
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
}

.big-level-info h3 {
    font-size: 30px;
    font-weight: 700;
    margin-top: 8px;
}

.progress-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
}

.progress-stats div {
    text-align: center;
    padding: 30px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    transition: all 0.3s ease;
}

.progress-stats div:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.progress-stats span {
    display: block;
    font-size: 28px;
}

.progress-stats strong {
    display: block;
    font-size: 32px;
    margin: 7px 0;
    font-weight: 800;
}

.progress-stats p {
    color: var(--muted);
    font-size: 14px;
}

/* ACHIEVEMENTS */

.achievement-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.achievement {
    padding: 25px;
    border-radius: 18px;
    background: var(--card);
    border: 1px solid var(--border);
    opacity: 0.45;
    transition: all 0.3s ease;
    cursor: default;
}

.achievement.unlocked {
    opacity: 1;
    box-shadow: var(--shadow);
}

.achievement.unlocked:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.achievement-icon {
    font-size: 35px;
    margin-bottom: 15px;
}

.achievement h3 {
    margin-bottom: 6px;
    font-size: 16px;
}

.achievement p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
}

/* FAVORITES */

.favorites-list {
    display: grid;
    gap: 15px;
}

.favorite-item {
    background: var(--card);
    border: 1px solid var(--border);
    padding: 22px;
    border-radius: 18px;
    transition: all 0.3s ease;
}

.favorite-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
}

.favorite-item h3 {
    color: var(--primary);
    margin-bottom: 10px;
    font-size: 16px;
}

.favorite-item p {
    font-family: 'Georgia', serif;
    line-height: 1.6;
    color: var(--text);
}

/* FOOTER */

footer {
    text-align: center;
    color: var(--muted);
    padding: 35px;
    font-size: 12px;
    border-top: 1px solid var(--border);
    margin-top: 50px;
}

/* MOBILE */

@media (max-width: 850px) {

    .topbar {
        height: auto;
        padding: 15px;
        flex-wrap: wrap;
    }

    nav {
        width: 100%;
        overflow-x: auto;
        padding-top: 10px;
    }

    .hero {
        flex-direction: column;
        align-items: flex-start;
        gap: 25px;
    }

    .dashboard-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .content-grid {
        grid-template-columns: 1fr;
    }

    .achievement-grid {
        grid-template-columns: 1fr;
    }

    .progress-stats {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 500px) {

    main {
        padding: 25px 15px;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .big-level-card {
        flex-direction: column;
        text-align: center;
    }

    .hero h2 {
        font-size: 40px;
    }

    .modal-content {
        width: 95%;
    }
}
